# Copy to .env and fill in your own values. Never commit .env.

# --- LLM provider: pick ONE ---
LLM_PROVIDER=anthropic          # anthropic | openai | ollama

ANTHROPIC_API_KEY=SET_YOUR_OWN
OPENAI_API_KEY=SET_YOUR_OWN

# Local model via Ollama needs no key.
OLLAMA_BASE_URL=http://localhost:11434

# --- Qdrant (local, via docker compose) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=tenders

# --- chunking: the numbers the eval score will move ---
CHUNK_MAX_CHARS=2000
CHUNK_OVERLAP_CHARS=500
TOP_K=3
