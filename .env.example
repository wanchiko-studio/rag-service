# Copy to .env and fill in your own values. Never commit .env.

# --- LLM provider (not used yet: retrieval works without a model) ---
LLM_PROVIDER=anthropic          # anthropic | openai | ollama

ANTHROPIC_API_KEY=SET_YOUR_OWN
OPENAI_API_KEY=SET_YOUR_OWN

# Local model via Ollama needs no key.
OLLAMA_BASE_URL=http://localhost:11434

# --- Qdrant ---
# Default is embedded: a local folder, no server, no Docker, one process at a time.
# Nothing to set — the folder is anchored to the repo automatically.
#
# ⚠️ Only set QDRANT_PATH if you want a store somewhere else, and then make it an
# ABSOLUTE path. A relative value is resolved against the current working directory,
# so indexing from the repo root and querying from elsewhere would open two different
# folders — and the empty one answers with silence rather than an error. Leaving this
# unset avoids the whole problem.
# QDRANT_PATH=/absolute/path/to/qdrant_storage
#
# Set QDRANT_URL to use the container instead (docker compose up -d). It wins over
# QDRANT_PATH. The two stores are separate: what you indexed into the folder is not
# in the container.
# QDRANT_URL=http://localhost:6333

QDRANT_COLLECTION=tenders

# --- chunking: the numbers rag-eval will move ---
# 🔑 1200, not 2000. The embedding model has a hard 512-token window and silently
# discards anything beyond it — no error, no warning. Measured on real Russian text:
#   2000 chars -> up to 627 tokens -> 4 of 6 chunks truncated
#   1200 chars -> up to 387 tokens -> none truncated
# Russian runs ~3.45 chars/token here, so 1200 leaves real headroom.
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=500
TOP_K=3
